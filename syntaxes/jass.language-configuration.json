{
    "comments": {
        "lineComment": "//"
    },
    "brackets": [
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "[", "close": "]", "notIn": ["string", "comment"] },
        { "open": "(", "close": ")", "notIn": ["string", "comment"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["[", "]"],
        ["(", ")"],
        ["'", "'"]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(function|if|else|elseif|loop|globals)\\b",
        "decreaseIndentPattern": "^\\s*(endfunction|endif|else|elseif|endloop|endglobals)\\b"
    }
}
