{
  "version": "0.0.22",
  "license": "MIT",
  "author": "WarRaft",
  "publisher": "WarRaft",
  "name": "jass-tree-sitter-rust",
  "displayName": "JASS-Tree-sitter-Rust",
  "contributors": [],
  "description": "Tools for develop WarCraft III maps.",
  "private": false,
  "icon": "images/logo.png",
  "pricing": "Free",
  "keywords": [
    "warcraft",
    "ujapi"
  ],
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WarRaft/JASS-Tree-sitter-Rust"
  },
  "bugs": {
    "url": "https://github.com/WarRaft/JASS-Tree-sitter-Rust/issues"
  },
  "main": "./extension/extension.js",
  "scripts": {
    "publish": "vsce publish patch"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1"
  },
  "configurationDefaults": {},
  "contributes": {
    "languages": [
      {
        "id": "bni",
        "aliases": [
          "Blizzard Notation Ini",
          "BNI"
        ],
        "extensions": [
          ".bni"
        ],
        "icon": {
          "light": "./icons/bni.svg",
          "dark": "./icons/bni.svg"
        },
        "configuration": "./syntaxes/bni.language-configuration.json"
      },
      {
        "id": "blp",
        "aliases": [
          "BLP Image"
        ],
        "extensions": [
          ".blp"
        ],
        "icon": {
          "light": "./icons/blp.svg",
          "dark": "./icons/blp.svg"
        },
        "configuration": "./syntaxes/blp.language-configuration.json"
      },
      {
        "id": "jass",
        "aliases": [
          "JASS"
        ],
        "extensions": [
          ".j",
          ".pld"
        ],
        "icon": {
          "light": "./icons/jass.svg",
          "dark": "./icons/jass.svg"
        },
        "configuration": "./syntaxes/jass.language-configuration.json"
      },
      {
        "id": "angelscript",
        "aliases": [
          "AngelScript",
          "AS"
        ],
        "extensions": [
          ".as"
        ],
        "icon": {
          "light": "./icons/as.svg",
          "dark": "./icons/as.svg"
        },
        "configuration": "./syntaxes/as.language-configuration.json"
      },
      {
        "id": "doo",
        "aliases": [
          "DOO Placement",
          "DOO"
        ],
        "extensions": [
          ".doo"
        ],
        "icon": {
          "light": "./icons/doo.svg",
          "dark": "./icons/doo.svg"
        }
      },
      {
        "id": "w3i",
        "aliases": [
          "W3I Map Info",
          "W3I"
        ],
        "extensions": [
          ".w3i"
        ],
        "icon": {
          "light": "./icons/w3i.svg",
          "dark": "./icons/w3i.svg"
        }
      }
    ],
    "configurationDefaults": {
      "[bni]": {
        "editor.selectionHighlight": false
      },
      "[jass]": {
        "editor.selectionHighlight": false
      },
      "[angelscript]": {
        "editor.selectionHighlight": false
      }
    },
    "grammars": [
      {
        "language": "jass",
        "scopeName": "source.jass",
        "path": "./syntaxes/jass.tmLanguage.json"
      },
      {
        "language": "angelscript",
        "scopeName": "source.angelscript",
        "path": "./syntaxes/as.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "blp.preview",
        "displayName": "BLP Image Viewer",
        "selector": [
          {
            "filenamePattern": "*.blp"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "doo.preview",
        "displayName": "DOO Placement Viewer",
        "selector": [
          {
            "filenamePattern": "*.doo"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "w3i.preview",
        "displayName": "W3I Map Info Viewer",
        "selector": [
          {
            "filenamePattern": "*.w3i"
          }
        ],
        "priority": "default"
      }
    ],
    "activationEvents": [
      "onCustomEditor:blp.preview",
      "onCustomEditor:doo.preview",
      "onCustomEditor:w3i.preview"
    ],
    "commands": [
      {
        "command": "importGraph.show",
        "title": "%command.importGraph.show%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "callGraph.show",
        "title": "%command.callGraph.show%",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "typeGraph.show",
        "title": "%command.typeGraph.show%",
        "icon": "$(symbol-class)"
      },
      {
        "command": "rescan.execute",
        "title": "%command.rescan.execute%",
        "icon": "$(refresh)"
      },
      {
        "command": "build.execute",
        "title": "%command.build.execute%",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "importGraph.show",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        },
        {
          "command": "callGraph.show",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        },
        {
          "command": "typeGraph.show",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        },
        {
          "command": "rescan.execute",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        },
        {
          "command": "build.execute",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        }
      ]
    }
  }
}
