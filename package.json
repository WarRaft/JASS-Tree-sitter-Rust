{
  "version": "0.0.19",
  "license": "MIT",
  "author": "WarRaft",
  "publisher": "WarRaft",
  "name": "jass-tree-sitter-rust",
  "displayName": "JASS-Tree-sitter-Rust",
  "contributors": [],
  "description": "Tools for develop WarCraft III maps.",
  "private": false,
  "icon": "images/logo.png",
  "pricing": "Free",
  "keywords": [
    "warcraft",
    "ujapi"
  ],
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WarRaft/JASS-Tree-sitter-Rust"
  },
  "bugs": {
    "url": "https://github.com/WarRaft/JASS-Tree-sitter-Rust/issues"
  },
  "main": "./extension/extension.js",
  "scripts": {
    "publish": "vsce publish patch"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1"
  },
  "configurationDefaults": {},
  "contributes": {
    "languages": [
      {
        "id": "bni",
        "aliases": [
          "Blizzard Notation Ini",
          "BNI"
        ],
        "extensions": [
          ".bni"
        ],
        "icon": {
          "light": "./icons/bni.svg",
          "dark": "./icons/bni.svg"
        },
        "configuration": "./syntaxes/bni.language-configuration.json"
      },
      {
        "id": "blp",
        "aliases": [
          "BLP Image"
        ],
        "extensions": [
          ".blp"
        ],
        "icon": {
          "light": "./icons/blp.svg",
          "dark": "./icons/blp.svg"
        },
        "configuration": "./syntaxes/blp.language-configuration.json"
      },
      {
        "id": "jass",
        "aliases": [
          "JASS"
        ],
        "extensions": [
          ".j",
          ".pld"
        ],
        "icon": {
          "light": "./icons/jass.svg",
          "dark": "./icons/jass.svg"
        },
        "configuration": "./syntaxes/jass.language-configuration.json"
      },
      {
        "id": "angelscript",
        "aliases": [
          "AngelScript",
          "AS"
        ],
        "extensions": [
          ".as"
        ],
        "icon": {
          "light": "./icons/as.svg",
          "dark": "./icons/as.svg"
        },
        "configuration": "./syntaxes/as.language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[bni]": {
        "editor.occurrencesHighlight": "off"
      },
      "[jass]": {
        "editor.occurrencesHighlight": "off"
      },
      "[angelscript]": {
        "editor.occurrencesHighlight": "off"
      }
    },
    "customEditors": [
      {
        "viewType": "blp.preview",
        "displayName": "BLP Image Viewer",
        "selector": [
          {
            "filenamePattern": "*.blp"
          }
        ],
        "priority": "default"
      }
    ],
    "activationEvents": [
      "onCustomEditor:blp.preview"
    ]
  }
}
