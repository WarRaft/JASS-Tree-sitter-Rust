{
  "version": "0.0.32",
  "license": "MIT",
  "author": "WarRaft",
  "publisher": "WarRaft",
  "name": "jass-tree-sitter-rust",
  "displayName": "JASS-Tree-sitter-Rust",
  "contributors": [],
  "description": "Tools for develop WarCraft III maps.",
  "private": false,
  "icon": "images/logo.png",
  "pricing": "Free",
  "keywords": [
    "warcraft",
    "ujapi"
  ],
  "engines": {
    "vscode": "^1.111.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WarRaft/JASS-Tree-sitter-Rust"
  },
  "bugs": {
    "url": "https://github.com/WarRaft/JASS-Tree-sitter-Rust/issues"
  },
  "main": "./extension/extension.js",
  "scripts": {
    "publish": "vsce publish patch"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@vscode/vsce": "^3.7.1"
  },
  "configurationDefaults": {},
  "contributes": {
    "languages": [
      {
        "id": "bni",
        "aliases": [
          "Blizzard Notation Ini",
          "BNI"
        ],
        "extensions": [
          ".bni"
        ],
        "icon": {
          "light": "./icons/bni.svg",
          "dark": "./icons/bni.svg"
        },
        "configuration": "./syntaxes/bni.language-configuration.json"
      },
      {
        "id": "blp",
        "aliases": [
          "BLP Image"
        ],
        "extensions": [
          ".blp"
        ],
        "icon": {
          "light": "./icons/blp.svg",
          "dark": "./icons/blp.svg"
        },
        "configuration": "./syntaxes/blp.language-configuration.json"
      },
      {
        "id": "jass",
        "aliases": [
          "JASS"
        ],
        "extensions": [
          ".j",
          ".pld",
          ".ai"
        ],
        "icon": {
          "light": "./icons/jass.svg",
          "dark": "./icons/jass.svg"
        },
        "configuration": "./syntaxes/jass.language-configuration.json"
      },
      {
        "id": "angelscript",
        "aliases": [
          "AngelScript",
          "AS"
        ],
        "extensions": [
          ".as"
        ],
        "icon": {
          "light": "./icons/as.svg",
          "dark": "./icons/as.svg"
        },
        "configuration": "./syntaxes/as.language-configuration.json"
      },
      {
        "id": "doo",
        "aliases": [
          "DOO Placement",
          "DOO"
        ],
        "extensions": [
          ".doo"
        ],
        "icon": {
          "light": "./icons/doo.svg",
          "dark": "./icons/doo.svg"
        }
      },
      {
        "id": "w3i",
        "aliases": [
          "W3I Map Info",
          "W3I"
        ],
        "extensions": [
          ".w3i"
        ],
        "icon": {
          "light": "./icons/w3i.svg",
          "dark": "./icons/w3i.svg"
        }
      },
      {
        "id": "w3x",
        "aliases": [
          "W3X Map Archive",
          "W3X"
        ],
        "extensions": [
          ".w3x"
        ],
        "icon": {
          "light": "./icons/w3x.svg",
          "dark": "./icons/w3x.svg"
        }
      },
      {
        "id": "w3m",
        "aliases": [
          "W3M Map Archive",
          "W3M"
        ],
        "extensions": [
          ".w3m"
        ],
        "icon": {
          "light": "./icons/w3m.svg",
          "dark": "./icons/w3m.svg"
        }
      },
      {
        "id": "w3n",
        "aliases": [
          "W3N Campaign Archive",
          "W3N"
        ],
        "extensions": [
          ".w3n"
        ],
        "icon": {
          "light": "./icons/w3n.svg",
          "dark": "./icons/w3n.svg"
        }
      },
      {
        "id": "mpq",
        "aliases": [
          "MPQ Archive",
          "MPQ"
        ],
        "extensions": [
          ".mpq"
        ],
        "icon": {
          "light": "./icons/mpq.svg",
          "dark": "./icons/mpq.svg"
        }
      },
      {
        "id": "wts",
        "aliases": [
          "WarCraft III Strings",
          "WTS"
        ],
        "extensions": [
          ".wts"
        ],
        "icon": {
          "light": "./icons/wts.svg",
          "dark": "./icons/wts.svg"
        },
        "configuration": "./syntaxes/wts.language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[bni]": {
        "editor.selectionHighlight": false
      },
      "[jass]": {
        "editor.selectionHighlight": false
      },
      "[angelscript]": {
        "editor.selectionHighlight": false
      },
      "[wts]": {
        "editor.selectionHighlight": false
      }
    },
    "grammars": [
      {
        "language": "jass",
        "scopeName": "source.jass",
        "path": "./syntaxes/jass.tmLanguage.json"
      },
      {
        "language": "angelscript",
        "scopeName": "source.angelscript",
        "path": "./syntaxes/as.tmLanguage.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "blp.preview",
        "displayName": "%customEditor.blp.displayName%",
        "selector": [
          {
            "filenamePattern": "*.blp"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "doo.preview",
        "displayName": "%customEditor.doo.displayName%",
        "selector": [
          {
            "filenamePattern": "*.doo"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "w3i.preview",
        "displayName": "%customEditor.w3i.displayName%",
        "selector": [
          {
            "filenamePattern": "*.w3i"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "mpq.preview",
        "displayName": "%customEditor.mpq.displayName%",
        "selector": [
          {
            "filenamePattern": "*.w3x"
          },
          {
            "filenamePattern": "*.w3m"
          },
          {
            "filenamePattern": "*.w3n"
          },
          {
            "filenamePattern": "*.mpq"
          }
        ],
        "priority": "default"
      }
    ],
    "activationEvents": [
      "onCustomEditor:blp.preview",
      "onCustomEditor:doo.preview",
      "onCustomEditor:w3i.preview",
      "onCustomEditor:mpq.preview"
    ],
    "commands": [
      {
        "command": "importGraph.show",
        "title": "%command.importGraph.show%",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "callGraph.show",
        "title": "%command.callGraph.show%",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "typeGraph.show",
        "title": "%command.typeGraph.show%",
        "icon": "$(symbol-class)"
      },
      {
        "command": "rescan.execute",
        "title": "%command.rescan.execute%",
        "icon": "$(refresh)"
      },
      {
        "command": "build.execute",
        "title": "%command.build.execute%",
        "icon": "$(play)"
      },
      {
        "command": "ujapi.download",
        "title": "%command.ujapi.download%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "mpq.browse",
        "title": "%command.mpq.browse%",
        "icon": "$(folder-opened)"
      },
      {
        "command": "mpq.openFile",
        "title": "%command.mpq.openFile%",
        "icon": "$(go-to-file)"
      },
      {
        "command": "jass.restartServer",
        "title": "%command.jass.restartServer%",
        "icon": "$(debug-restart)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mpq.browse",
          "when": "resourceExtname =~ /\\.(w3[xmn]|mpq)$/i",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "command": "importGraph.show",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        },
        {
          "command": "callGraph.show",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        },
        {
          "command": "typeGraph.show",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        },
        {
          "command": "rescan.execute",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        },
        {
          "command": "build.execute",
          "when": "resourceLangId == jass || resourceLangId == angelscript",
          "group": "navigation"
        }
      ]
    }
  }
}
